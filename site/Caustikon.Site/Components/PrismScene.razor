@using System.Numerics
@using Caustikon.Site.Services
@inject IJSRuntime Js
@inherits LocalizedComponent
@* White light through a polygon of a real glass, traced edge by edge with Dielectric.RefractUnit at each wavelength.
   At every face the beam splits by the exact Fresnel power: the transmitted part leaves, the reflected part keeps going
   inside, and both fade with the energy they carry; absorption over the path in millimetres comes from the glass's own
   k table, the temperature shift from its dn/dT, and the surrounding medium has an index of its own. *@

<div class="bench @(Editable ? "editable" : "")" @onpointerdown="OnPointerDown" @onpointermove="OnPointerMove" @onpointerup="OnPointerUp" @onpointerleave="OnPointerUp">
    @((MarkupString)svg)
</div>

@code {
    [Parameter, EditorRequired] public Glass Glass { get; set; } = default!;
    [Parameter] public IReadOnlyList<Vector2> Vertices { get; set; } = [];
    [Parameter] public double BeamAngleDegrees { get; set; } = 20;
    [Parameter] public double BeamHeight { get; set; } = 0.15;
    [Parameter] public int RayCount { get; set; } = 61;
    [Parameter] public double Zoom { get; set; } = 1;
    [Parameter] public double MillimetersPerUnit { get; set; } = 25;
    [Parameter] public double MediumIndex { get; set; } = 1.000273;
    [Parameter] public double TemperatureCelsius { get; set; } = 20;
    [Parameter] public bool ShowReflections { get; set; } = true;
    [Parameter] public bool Editable { get; set; }
    [Parameter] public EventCallback<Vector2[]> VerticesChanged { get; set; }
    [Parameter] public EventCallback<PrismScene> Traced { get; set; }

    private const double W = 1000, Hgt = 520, BaseScale = 300;
    private const string SvgId = "bench-svg";
    private const double AirAtD = 1.000273;
    private Vector2 origin = new(300, 440);
    private double scale = BaseScale;
    private string svg = "";

    public double MinimumDeviation { get; private set; } = double.NaN;
    public double MaximumDeviation { get; private set; } = double.NaN;
    public double SpreadDegrees => MaximumDeviation - MinimumDeviation;
    public int RaysThatExit { get; private set; }
    public double EnergyOut { get; private set; }
    public double EnergyAbsorbed { get; private set; }
    public double EnergyReflectedAtEntry { get; private set; }

    private (double, double, int, double) reported = (double.NaN, double.NaN, -1, double.NaN);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        (double, double, int, double) current = (MinimumDeviation, MaximumDeviation, RaysThatExit, EnergyOut);
        if (!Same(current, reported))
        {
            reported = current;
            await Traced.InvokeAsync(this);
        }
    }

    private static bool Same((double A, double B, int C, double D) x, (double A, double B, int C, double D) y) =>
        x.C == y.C && Eq(x.A, y.A) && Eq(x.B, y.B) && Eq(x.D, y.D);

    private static bool Eq(double a, double b) => a.Equals(b) || (double.IsNaN(a) && double.IsNaN(b));

    protected override void OnParametersSet()
    {
        Vector2[] vertices = [.. Vertices];
        double zoom = Math.Clamp(Zoom, 0.25, 6);
        scale = BaseScale * zoom;

        // At 1× the bench shows source, shape and screen; zooming in closes on the shape's centroid.
        Vector2 centroid = Vector2.Zero;
        foreach (Vector2 v in vertices)
        {
            centroid += v;
        }

        if (vertices.Length > 0)
        {
            centroid /= vertices.Length;
        }

        Vector2 wide = new((float)(300 - (1 - Math.Min(zoom, 1)) * 150), (float)(440 - (1 - Math.Min(zoom, 1)) * 100));
        Vector2 tight = new((float)(W / 2 - centroid.X * scale), (float)(Hgt / 2 + centroid.Y * scale));
        float blend = (float)Math.Clamp((zoom - 1) / 1.2, 0, 1);
        origin = Vector2.Lerp(wide, tight, blend);

        double angle = BeamAngleDegrees * Math.PI / 180;
        Vector2 incident = new((float)Math.Cos(angle), (float)Math.Sin(angle));
        Vector2 source = new(-0.75f, (float)BeamHeight);
        float medium = (float)MediumIndex;

        System.Text.StringBuilder s = new();
        s.Append("<svg id=\"").Append(SvgId).Append("\" class=\"prism\" viewBox=\"0 0 ").Append(F(W)).Append(' ').Append(F(Hgt))
         .Append("\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"White light through ")
         .Append(Esc(Glass.VendorDisplayName + " " + Glass.Name)).Append("\">");
        s.Append("<rect width=\"100%\" height=\"100%\" fill=\"#0c1013\"/>");

        const double screenX = 2.2;
        s.Append("<line class=\"screen\" x1=\"").Append(F(P(new Vector2((float)screenX, -3f)).X)).Append("\" y1=\"").Append(F(P(new Vector2((float)screenX, -3f)).Y))
         .Append("\" x2=\"").Append(F(P(new Vector2((float)screenX, 4f)).X)).Append("\" y2=\"").Append(F(P(new Vector2((float)screenX, 4f)).Y)).Append("\"/>");

        bool hasShape = vertices.Length >= 3;
        (Vector2 entry, int entryEdge) = hasShape ? Intersect(source, incident, vertices, -1) : (source + incident * 3f, -1);
        bool hits = hasShape && entryEdge >= 0;
        Vector2 beamEnd = hits ? entry : source + incident * 4f;

        s.Append("<line class=\"beam\" x1=\"").Append(F(P(source).X)).Append("\" y1=\"").Append(F(P(source).Y))
         .Append("\" x2=\"").Append(F(P(beamEnd).X)).Append("\" y2=\"").Append(F(P(beamEnd).Y)).Append("\"/>");

        double minDev = double.PositiveInfinity, maxDev = double.NegativeInfinity;
        int exits = 0, traced = 0;
        double energyOut = 0, energyAbsorbed = 0, energyReflected = 0;
        System.Text.StringBuilder hitsOnScreen = new();
        if (hits)
        {
            s.Append("<g class=\"fan\">");
            Vector2 entryNormal = OutwardNormal(vertices, entryEdge, entry);
            for (int i = 0; i < RayCount; i++)
            {
                double wavelength = RayCount == 1 ? 550 : 400 + 300.0 * i / (RayCount - 1);
                double nGlass = IndexAt(wavelength);
                if (double.IsNaN(nGlass))
                {
                    continue;
                }

                traced++;
                (double r, double g, double bl) = GlassColour.Monochromatic(wavelength);
                string colour = $"rgb({(int)Math.Round(r * 255)},{(int)Math.Round(g * 255)},{(int)Math.Round(bl * 255)})";
                float nf = (float)nGlass;

                float cosIn = Math.Clamp(-Vector2.Dot(incident, entryNormal), 0f, 1f);
                double reflectedAtEntry = Dielectric.Fresnel(cosIn, medium, nf).Unpolarized;
                energyReflected += reflectedAtEntry;
                if (ShowReflections && i == RayCount / 2)
                {
                    Vector2 reflected = Reflect(incident, entryNormal);
                    Vector2 end = entry + reflected * 4f;
                    s.Append("<line class=\"ghost\" style=\"opacity:").Append(F(Math.Min(1, reflectedAtEntry * 3))).Append("\" x1=\"").Append(F(P(entry).X)).Append("\" y1=\"").Append(F(P(entry).Y))
                     .Append("\" x2=\"").Append(F(P(end).X)).Append("\" y2=\"").Append(F(P(end).Y)).Append("\"/>");
                }

                if (Refract(incident, entryNormal, medium, nf, out Vector2 inside) != RefractionKind.Refracted)
                {
                    continue;
                }

                double weight = 1 - reflectedAtEntry;
                Vector2 position = entry;
                Vector2 direction = inside;
                int lastEdge = entryEdge;
                bool firstExit = true;
                for (int bounce = 0; bounce < 10 && weight > 0.004; bounce++)
                {
                    (Vector2 hit, int edge) = Intersect(position, direction, vertices, lastEdge);
                    if (edge < 0)
                    {
                        break;
                    }

                    double chordMm = Vector2.Distance(position, hit) * MillimetersPerUnit;
                    double before = weight;
                    weight *= Transmittance(wavelength, chordMm);
                    energyAbsorbed += before - weight;
                    AppendSegment(s, position, hit, colour, weight, null);

                    Vector2 normal = OutwardNormal(vertices, edge, hit);
                    float cosInside = Math.Clamp(Vector2.Dot(direction, normal), 0f, 1f);
                    RefractionKind kind = Refract(direction, -normal, nf, medium, out Vector2 outDir);
                    double reflectance = kind == RefractionKind.Refracted ? Dielectric.Fresnel(cosInside, nf, medium).Unpolarized : 1;
                    if (kind == RefractionKind.Refracted)
                    {
                        double outWeight = weight * (1 - reflectance);
                        double travel = outDir.X > 1e-6 ? (screenX - hit.X) / outDir.X : 4;
                        travel = Math.Clamp(travel, 0.05, 6);
                        Vector2 end = hit + outDir * (float)travel;
                        double deviation = Math.Acos(Math.Clamp(Vector2.Dot(incident, outDir), -1, 1)) * 180 / Math.PI;
                        AppendSegment(s, hit, end, colour, outWeight, $"{wavelength:0.#} nm · n {nGlass:0.00000} · {deviation:0.000}° · {outWeight * 100:0.0}%");
                        if (outDir.X > 1e-6 && Math.Abs(end.X - screenX) < 1e-3)
                        {
                            Vector2 p = P(end);
                            hitsOnScreen.Append("<line class=\"hit\" style=\"stroke:").Append(colour).Append(";opacity:").Append(F(Math.Min(1, outWeight * 1.2)))
                                        .Append("\" x1=\"").Append(F(p.X - 7)).Append("\" x2=\"").Append(F(p.X + 7)).Append("\" y1=\"").Append(F(p.Y)).Append("\" y2=\"").Append(F(p.Y)).Append("\"/>");
                        }

                        energyOut += outWeight;
                        if (firstExit)
                        {
                            minDev = Math.Min(minDev, deviation);
                            maxDev = Math.Max(maxDev, deviation);
                            exits++;
                            firstExit = false;
                        }

                        if (!ShowReflections)
                        {
                            break;
                        }
                    }

                    weight *= reflectance;
                    direction = Reflect(direction, normal);
                    position = hit;
                    lastEdge = edge;
                }
            }

            s.Append("</g>");
            s.Append("<g class=\"fan\">").Append(hitsOnScreen).Append("</g>");
        }

        if (hasShape)
        {
            s.Append("<polygon class=\"glass\" points=\"");
            foreach (Vector2 v in vertices)
            {
                Vector2 p = P(v);
                s.Append(F(p.X)).Append(',').Append(F(p.Y)).Append(' ');
            }

            s.Append("\"/>");
        }

        double barPx = 10 / MillimetersPerUnit * scale;
        s.Append("<line class=\"scalebar\" x1=\"").Append(F(W - 40 - barPx)).Append("\" x2=\"").Append(F(W - 40)).Append("\" y1=\"").Append(F(Hgt - 24)).Append("\" y2=\"").Append(F(Hgt - 24)).Append("\"/>");
        s.Append("<text class=\"scalelabel\" x=\"").Append(F(W - 40)).Append("\" y=\"").Append(F(Hgt - 31)).Append("\" text-anchor=\"end\">10 mm</text>");

        if (Editable)
        {
            foreach (Vector2 v in vertices)
            {
                Vector2 p = P(v);
                s.Append("<circle class=\"corner\" cx=\"").Append(F(p.X)).Append("\" cy=\"").Append(F(p.Y)).Append("\" r=\"7\"/>");
            }
        }

        s.Append("</svg>");
        svg = s.ToString();
        MinimumDeviation = double.IsFinite(minDev) ? minDev : double.NaN;
        MaximumDeviation = double.IsFinite(maxDev) ? maxDev : double.NaN;
        RaysThatExit = exits;
        EnergyOut = traced > 0 ? energyOut / traced : double.NaN;
        EnergyAbsorbed = traced > 0 ? energyAbsorbed / traced : double.NaN;
        EnergyReflectedAtEntry = traced > 0 ? energyReflected / traced : double.NaN;
    }

    private void AppendSegment(System.Text.StringBuilder s, Vector2 from, Vector2 to, string colour, double weight, string? title)
    {
        Vector2 a = P(from), b = P(to);
        s.Append("<line class=\"ray\" style=\"stroke:").Append(colour).Append(";opacity:").Append(F(Math.Clamp(weight * 0.95, 0.03, 0.95)))
         .Append("\" x1=\"").Append(F(a.X)).Append("\" y1=\"").Append(F(a.Y)).Append("\" x2=\"").Append(F(b.X)).Append("\" y2=\"").Append(F(b.Y)).Append("\">");
        if (title is not null)
        {
            s.Append("<title>").Append(Esc(title)).Append("</title>");
        }

        s.Append("</line>");
    }

    /// <summary>The glass's absolute index at a wavelength and the bench temperature.</summary>
    private double IndexAt(double wavelength)
    {
        IDispersionModel model = Glass.Model;
        double clamped = Math.Clamp(wavelength, model.MinimumWavelengthNanometers, model.MaximumWavelengthNanometers);
        if (model.EvaluateNanometers(clamped, out double relative) != DispersionStatus.Success)
        {
            return double.NaN;
        }

        // Catalog indices are relative to air at 20 °C; make them absolute so the medium can be anything.
        double absolute = relative * AirAtD;
        if (Glass.Thermal is { } thermal)
        {
            absolute += thermal.AbsoluteIndexShift(absolute, clamped, TemperatureCelsius);
        }

        return absolute;
    }

    private double Transmittance(double wavelength, double pathMm)
    {
        if (Glass.Extinction is not { } extinction)
        {
            return 1;
        }

        double clamped = Math.Clamp(wavelength, extinction.MinimumWavelengthNanometers, extinction.MaximumWavelengthNanometers);
        extinction.InternalTransmittance(clamped, pathMm, out double t);
        return t;
    }

    private int dragging = -1;
    private double[] benchRect = [];

    private async Task OnPointerDown(PointerEventArgs e)
    {
        if (!Editable || Vertices.Count == 0)
        {
            return;
        }

        benchRect = await Js.InvokeAsync<double[]>("caustikonSvg.rect", SvgId);
        Vector2 scene = ToScene(e.ClientX, e.ClientY);
        double best = double.PositiveInfinity;
        for (int i = 0; i < Vertices.Count; i++)
        {
            double d = Vector2.DistanceSquared(Vertices[i], scene);
            if (d < best)
            {
                best = d;
                dragging = i;
            }
        }

        if (Math.Sqrt(best) * scale > 22)
        {
            dragging = -1;
        }
    }

    private async Task OnPointerMove(PointerEventArgs e)
    {
        if (dragging < 0 || benchRect.Length < 4)
        {
            return;
        }

        Vector2[] moved = [.. Vertices];
        Vector2 scene = ToScene(e.ClientX, e.ClientY);
        moved[dragging] = new Vector2(Math.Clamp(scene.X, -1.5f, 3f), Math.Clamp(scene.Y, -2f, 3f));
        await VerticesChanged.InvokeAsync(moved);
    }

    private Task OnPointerUp(PointerEventArgs e)
    {
        dragging = -1;
        return Task.CompletedTask;
    }

    private Vector2 ToScene(double clientX, double clientY)
    {
        double k = W / benchRect[2];
        double ux = (clientX - benchRect[0]) * k;
        double uy = (clientY - benchRect[1]) * k;
        return new Vector2((float)((ux - origin.X) / scale), (float)((origin.Y - uy) / scale));
    }

    private Vector2 P(Vector2 scene) => new((float)(origin.X + scene.X * scale), (float)(origin.Y - scene.Y * scale));

    private static Vector2 OutwardNormal(Vector2[] vertices, int edge, Vector2 at)
    {
        Vector2 p0 = vertices[edge];
        Vector2 p1 = vertices[(edge + 1) % vertices.Length];
        Vector2 along = Vector2.Normalize(p1 - p0);
        Vector2 normal = new(along.Y, -along.X);
        Vector2 probe = at - normal * 1e-3f;
        return Contains(vertices, probe) ? normal : -normal;
    }

    private static bool Contains(Vector2[] vertices, Vector2 point)
    {
        bool inside = false;
        for (int i = 0, j = vertices.Length - 1; i < vertices.Length; j = i++)
        {
            Vector2 a = vertices[i], b = vertices[j];
            if ((a.Y > point.Y) != (b.Y > point.Y) && point.X < (b.X - a.X) * (point.Y - a.Y) / (b.Y - a.Y) + a.X)
            {
                inside = !inside;
            }
        }

        return inside;
    }

    private static (Vector2 Point, int Edge) Intersect(Vector2 origin, Vector2 direction, Vector2[] vertices, int skipEdge)
    {
        double best = double.PositiveInfinity;
        int bestEdge = -1;
        Vector2 bestPoint = origin;
        for (int edge = 0; edge < vertices.Length; edge++)
        {
            if (edge == skipEdge)
            {
                continue;
            }

            Vector2 p0 = vertices[edge];
            Vector2 p1 = vertices[(edge + 1) % vertices.Length];
            Vector2 e = p1 - p0;
            double denominator = direction.X * e.Y - direction.Y * e.X;
            if (Math.Abs(denominator) < 1e-9)
            {
                continue;
            }

            Vector2 d = p0 - origin;
            double t = (d.X * e.Y - d.Y * e.X) / denominator;
            double u = (d.X * direction.Y - d.Y * direction.X) / denominator;
            if (t > 1e-5 && u >= -1e-6 && u <= 1 + 1e-6 && t < best)
            {
                best = t;
                bestEdge = edge;
                bestPoint = origin + direction * (float)t;
            }
        }

        return (bestPoint, bestEdge);
    }

    private static RefractionKind Refract(Vector2 incident, Vector2 normalIntoIncidentMedium, float nIn, float nOut, out Vector2 transmitted)
    {
        Vector3 i = Vector3.Normalize(new Vector3(incident, 0));
        Vector3 nrm = Vector3.Normalize(new Vector3(normalIntoIncidentMedium, 0));
        RefractionKind kind = Dielectric.RefractUnit(i, nrm, nIn, nOut, out Vector3 t);
        transmitted = kind == RefractionKind.Refracted ? Vector2.Normalize(new Vector2(t.X, t.Y)) : Vector2.Zero;
        return kind;
    }

    private static Vector2 Reflect(Vector2 direction, Vector2 normal) => direction - 2 * Vector2.Dot(direction, normal) * normal;

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string Esc(string v) => System.Net.WebUtility.HtmlEncode(v);
}
