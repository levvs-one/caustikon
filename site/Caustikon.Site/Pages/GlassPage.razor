@page "/glass/{Vendor}/{Name}"
@inherits LocalizedComponent

@if (glass is null)
{
    <PageTitle>@L["glass.notfound.h"] · Caustikon</PageTitle>
    <h1>@L["glass.notfound.h"]</h1>
    <p>@H("glass.notfound.p", "<code>" + System.Net.WebUtility.HtmlEncode(Name) + "</code>", "<code>" + System.Net.WebUtility.HtmlEncode(Vendor) + "</code>")</p>
}
else
{
    <PageTitle>@glass.VendorDisplayName @glass.Name · Caustikon</PageTitle>

    <p class="muted"><a href="catalog">@L["nav.catalog"]</a> › @glass.VendorDisplayName</p>
    <h1>@glass.Name <span class="badge">@Catalog.StatusText(L, glass.Status)</span> @if (glass.Category != "optical") { <span class="badge">@glass.Category</span> }</h1>
    <p class="lede">@glass.VendorDisplayName · @(glass.GlassCode is null ? "" : L["glass.code"] + " " + glass.GlassCode + " · ")@T("glass.fit", glass.Formula, SiteInfo.Compact(glass.Model.MinimumWavelengthNanometers), SiteInfo.Compact(glass.Model.MaximumWavelengthNanometers))</p>

    <div class="figures">
        <div class="figure"><div class="value">@Printed(glass.CatalogIndexD, 5)</div><div class="label">@H("glass.nd", SiteInfo.Number(glass.IndexD, 5))</div></div>
        <div class="figure"><div class="value">@Printed(glass.CatalogAbbeD, 2)</div><div class="label">@H("glass.vd", SiteInfo.Number(glass.AbbeD, 2))</div></div>
        <div class="figure"><div class="value">@SiteInfo.Number(glass.IndexF, 5)</div><div class="label">@H("glass.nf")</div></div>
        <div class="figure"><div class="value">@SiteInfo.Number(glass.IndexC, 5)</div><div class="label">@H("glass.nc")</div></div>
        <div class="figure"><div class="value">@Printed(glass.DensityKgPerM3, 0)</div><div class="label">@L["glass.density"]</div></div>
        <div class="figure"><div class="value">@Printed(glass.ReferenceTemperatureKelvin, 0)</div><div class="label">@L["glass.temperature"]</div></div>
    </div>

    <h2>@L["glass.index.h"]</h2>
    <div class="panel">
        <LineChart Series="indexSeries" Title="@L["glass.index.h"]" XLabel="@L["chart.wavelength"]" YLabel="n" Band="(380, 780)" Markers="lineMarkers" />
    </div>
    <p class="muted">@H("glass.index.note")</p>

    <div class="table-scroll">
        <table class="compact">
            <thead><tr><th>@L["glass.line"]</th><th class="num">λ, nm</th><th class="num">n</th></tr></thead>
            <tbody>
                @foreach ((string label, double wavelength) in Lines)
                {
                    <tr><td>@label</td><td class="num">@SiteInfo.Number(wavelength, 4)</td><td class="num">@IndexAt(wavelength)</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (glass.Extinction is { } extinction)
    {
        <h2>@L["glass.absorption.h"]</h2>
        <div class="controls">
            <label class="control">
                <span class="range-label"><span>@L["glass.path"]</span><output>@thickness mm</output></span>
                <input type="range" min="1" max="100" step="1" @bind="thickness" @bind:event="oninput" />
            </label>
            <label class="check"><input type="checkbox" @bind="withSurfaces" /> @L["glass.surfaces"]</label>
        </div>
        <div class="columns">
            <div class="panel">
                <LineChart Series="transmittanceSeries" Title="τi" XLabel="@L["chart.wavelength"]" YLabel="τi" YMin="0" YMax="1" Band="(380, 780)" />
            </div>
            <div>
                @if (colour is { } c)
                {
                    <SpectrumStrip Transmittance="SpectralTransmittance" Label="@T("spectrum.glass", thickness, glass.Name)" />
                    <div class="swatch-block" style="background: @c.Hex; margin-top: 0.8rem"></div>
                    <dl class="kv">
                        <dt>@L["glass.colour.srgb"]</dt><dd>@c.Hex · @c.Rgb8.Red, @c.Rgb8.Green, @c.Rgb8.Blue</dd>
                        <dt>@L["glass.colour.y"]</dt><dd>@SiteInfo.Number(c.Y, 4)</dd>
                        <dt>XYZ</dt><dd>@SiteInfo.Number(c.X, 4), @SiteInfo.Number(c.Y, 4), @SiteInfo.Number(c.Z, 4)</dd>
                        <dt>@L["glass.colour.illuminant"]</dt><dd>@L["glass.colour.illuminant.v"]</dd>
                        <dt>@L["glass.colour.coverage"]</dt><dd>@SiteInfo.Compact(c.CoverageMinimumNanometers)–@SiteInfo.Compact(c.CoverageMaximumNanometers) nm @L["glass.colour.of"]</dd>
                        @if (c.ClippedToGamut)
                        {
                            <dt>@L["glass.colour.gamut"]</dt><dd>@L["glass.colour.gamut.v"]</dd>
                        }
                    </dl>
                    <p class="muted">@T("glass.colour.note", thickness, withSurfaces ? L["glass.colour.note.surfaces"] : "", SiteInfo.Compact(extinction.MinimumWavelengthNanometers), SiteInfo.Compact(extinction.MaximumWavelengthNanometers), extinction.Count)</p>
                }
            </div>
        </div>
    }

    @if (glass.Thermal is { } thermal)
    {
        <h2>@L["glass.thermal.h"]</h2>
        <div class="controls">
            <label class="control">
                <span class="range-label"><span>@L["glass.thermal.t"]</span><output>@temperature °C</output></span>
                <input type="range" min="-40" max="80" step="1" @bind="temperature" @bind:event="oninput" />
            </label>
        </div>
        <div class="table-scroll">
            <table class="compact">
                <thead><tr><th>@L["glass.line"]</th><th class="num">@H("glass.thermal.n", thermal.ReferenceTemperatureCelsius)</th><th class="num">@H("glass.thermal.dn", temperature)</th><th class="num">@H("glass.thermal.slope", thermal.ReferenceTemperatureCelsius)</th></tr></thead>
                <tbody>
                    @foreach ((string label, double wavelength) in Lines)
                    {
                        if (glass.IndexAt(wavelength, out double n) == DispersionStatus.Success)
                        {
                            <tr>
                                <td>@label</td>
                                <td class="num">@SiteInfo.Number(n, 5)</td>
                                <td class="num">@((thermal.AbsoluteIndexShift(n, wavelength, temperature) * 1e6).ToString("+0.0;-0.0;0.0", CultureInfo.InvariantCulture)) × 10⁻⁶</td>
                                <td class="num">@SiteInfo.Number(thermal.AbsoluteSlopeAtReference(n, wavelength) * 1e6, 2)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <p class="muted">@H("glass.thermal.note")</p>
    }

    <h2>@L["glass.model.h"]</h2>
    <div class="equation">@FormulaText</div>
    <div class="table-scroll">
        <table class="compact">
            <thead><tr>@foreach (string h in coefficientHeaders) { <th class="num">@h</th> }</tr></thead>
            <tbody>
                @foreach (string[] row in coefficientRows)
                {
                    <tr>@foreach (string cell in row) { <td class="num">@cell</td> }</tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted">@H("glass.model.note", VendorClass + "." + Identifier)</p>

    <h2>@L["glass.provenance.h"]</h2>
    <dl class="kv">
        <dt>@L["glass.provenance.source"]</dt><dd>@glass.Provenance.Source</dd>
        <dt>@L["glass.provenance.citation"]</dt><dd>@glass.Provenance.Citation</dd>
        @if (glass.Provenance.Url is { } url)
        {
            <dt>@L["glass.provenance.reference"]</dt><dd><a href="@url" rel="noopener">@url</a></dd>
        }
        <dt>@L["glass.provenance.path"]</dt><dd><a href="https://github.com/polyanskiy/refractiveindex.info-database/blob/master/database/@glass.Provenance.Path" rel="noopener">@glass.Provenance.Path</a></dd>
        <dt>@L["glass.provenance.retrieved"]</dt><dd>@glass.Provenance.RetrievedOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</dd>
        @if (glass.Provenance.Notes.Length > 0)
        {
            <dt>@L["glass.provenance.notes"]</dt><dd>@glass.Provenance.Notes</dd>
        }
        @if (glass.PartialDispersionDeviationGF is { } dp)
        {
            <dt>ΔP<sub>g,F</sub></dt><dd>@SiteInfo.Number(dp, 4)</dd>
        }
    </dl>
}

@code {
    [Parameter] public string Vendor { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";

    private static readonly (string Label, double Wavelength)[] Lines =
    [
        ("i (Hg)", FraunhoferLines.INanometers), ("h (Hg)", FraunhoferLines.HNanometers), ("g (Hg)", FraunhoferLines.GNanometers),
        ("F (H)", FraunhoferLines.FNanometers), ("e (Hg)", FraunhoferLines.ENanometers), ("d (He)", FraunhoferLines.DNanometers),
        ("C (H)", FraunhoferLines.CNanometers), ("r (He)", FraunhoferLines.RNanometers),
    ];

    private static readonly double[] lineMarkers = [FraunhoferLines.FNanometers, FraunhoferLines.DNanometers, FraunhoferLines.CNanometers];

    private Glass? glass;
    private List<ChartSeries> indexSeries = [];
    private List<ChartSeries> transmittanceSeries = [];
    private string[] coefficientHeaders = [];
    private List<string[]> coefficientRows = [];
    private double thicknessValue = 10;
    private bool surfacesValue;
    private double temperature = 20;
    private TransmittedColour? colour;

    private double thickness
    {
        get => thicknessValue;
        set { thicknessValue = value; UpdateTransmittance(); }
    }

    private bool withSurfaces
    {
        get => surfacesValue;
        set { surfacesValue = value; UpdateTransmittance(); }
    }

    protected override void OnParametersSet()
    {
        glass = GlassCatalog.Find(Vendor, Name);
        if (glass is null)
        {
            return;
        }

        IDispersionModel model = glass.Model;
        List<(double, double)> points = [];
        double min = model.MinimumWavelengthNanometers;
        double max = model.MaximumWavelengthNanometers;
        for (int i = 0; i <= 240; i++)
        {
            double wavelength = min + (max - min) * i / 240d;
            points.Add((wavelength, model.EvaluateNanometers(wavelength, out double n) == DispersionStatus.Success ? n : double.NaN));
        }

        indexSeries = [new ChartSeries("n", points)];
        BuildCoefficientTable(glass);
        UpdateTransmittance();
    }

    private double SpectralTransmittance(double wavelength)
    {
        if (glass?.Extinction is not { } extinction)
        {
            return 1;
        }

        double clamped = Math.Clamp(wavelength, extinction.MinimumWavelengthNanometers, extinction.MaximumWavelengthNanometers);
        extinction.InternalTransmittance(clamped, thicknessValue, out double t);
        if (surfacesValue && glass.IndexAt(Math.Clamp(wavelength, glass.Model.MinimumWavelengthNanometers, glass.Model.MaximumWavelengthNanometers), out double n) == DispersionStatus.Success)
        {
            double pass = 1 - Dielectric.NormalReflectance(1f, (float)n);
            t *= pass * pass;
        }

        return t;
    }

    private void UpdateTransmittance()
    {
        if (glass?.Extinction is not { } extinction)
        {
            transmittanceSeries = [];
            colour = null;
            return;
        }

        List<(double, double)> points = [];
        double min = extinction.MinimumWavelengthNanometers;
        double max = Math.Min(extinction.MaximumWavelengthNanometers, 2_500d);
        for (int i = 0; i <= 300; i++)
        {
            double wavelength = min + (max - min) * i / 300d;
            extinction.InternalTransmittance(wavelength, thicknessValue, out double t);
            points.Add((wavelength, t));
        }

        transmittanceSeries = [new ChartSeries($"τi, {thicknessValue} mm", points)];
        colour = GlassColour.Transmitted(glass, thicknessValue, surfacesValue);
    }

    private void BuildCoefficientTable(Glass glass)
    {
        string term = L["glass.model.term"], power = L["glass.model.power"], offset = L["glass.model.offset"];
        switch (glass.Model)
        {
            case Sellmeier s:
                coefficientHeaders = [term, "Bᵢ", "Cᵢ, µm²"];
                coefficientRows = [[offset, SiteInfo.Compact(s.Offset), ""]];
                for (int i = 0; i < s.TermCount; i++)
                {
                    coefficientRows.Add([(i + 1).ToString(CultureInfo.InvariantCulture), G(s.StrengthAt(i)), G(s.ResonanceUm2At(i))]);
                }
                break;
            case Polynomial p:
                coefficientHeaders = [term, "aᵢ", power];
                coefficientRows = [["a₀", G(p.Offset), "0"]];
                for (int i = 0; i < p.TermCount; i++)
                {
                    coefficientRows.Add([(i + 1).ToString(CultureInfo.InvariantCulture), G(p.CoefficientAt(i)), SiteInfo.Compact(p.ExponentAt(i))]);
                }
                break;
            case Cauchy c:
                coefficientHeaders = [term, "aᵢ", power];
                coefficientRows = [["a₀", G(c.Offset), "0"]];
                for (int i = 0; i < c.TermCount; i++)
                {
                    coefficientRows.Add([(i + 1).ToString(CultureInfo.InvariantCulture), G(c.CoefficientAt(i)), SiteInfo.Compact(c.ExponentAt(i))]);
                }
                break;
            default:
                coefficientHeaders = [];
                coefficientRows = [];
                break;
        }
    }

    private string FormulaText => glass?.Formula switch
    {
        DispersionFormula.Sellmeier => "n² − 1 = offset + Σ Bᵢ λ² / (λ² − Cᵢ)",
        DispersionFormula.Polynomial => "n² = a₀ + Σ aᵢ λ^pᵢ",
        DispersionFormula.Cauchy => "n = a₀ + Σ aᵢ λ^pᵢ",
        _ => "",
    };

    private string VendorClass => glass is null ? "" : char.ToUpperInvariant(glass.Vendor[0]) + glass.Vendor[1..];

    private string Identifier
    {
        get
        {
            if (glass is null) return "";
            string id = new(glass.Name.Where(char.IsAsciiLetterOrDigit).ToArray());
            return id.Length > 0 && char.IsAsciiDigit(id[0]) ? "G" + id : id;
        }
    }

    private string IndexAt(double wavelength) =>
        glass!.IndexAt(wavelength, out double n) == DispersionStatus.Success ? SiteInfo.Number(n, 5) : L["glass.outside"];

    private static string Printed(double? value, int decimals) => value is { } v ? SiteInfo.Number(v, decimals) : "—";

    private static string G(double value) => value.ToString("G10", CultureInfo.InvariantCulture);
}
