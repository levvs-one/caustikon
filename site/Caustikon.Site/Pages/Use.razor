@page "/use"
@inject IJSRuntime Js
@inherits LocalizedComponent

<PageTitle>@L["use.title"]</PageTitle>

<h1>@L["use.h1"]</h1>
<p class="lede">@L["use.lede"]</p>

<div class="controls">
    <label class="control">
        <span>@L["use.glass"]</span>
        <select @bind="selectedKey">
            <optgroup label="@L["render.common"]">
                @foreach ((string key, string label) in Featured)
                {
                    <option value="@key">@label</option>
                }
            </optgroup>
            @foreach (string vendor in GlassCatalog.Vendors)
            {
                <optgroup label="@(GlassCatalog.ByVendor(vendor).First().VendorDisplayName)">
                    @foreach (Glass g in GlassCatalog.ByVendor(vendor).Where(g => g.CatalogIndexD is not null))
                    {
                        <option value="@(g.Vendor + "/" + g.Name)">@g.Name (@SiteInfo.Number(g.CatalogIndexD!.Value, 4) / @SiteInfo.Number(g.CatalogAbbeD ?? double.NaN, 1))</option>
                    }
                </optgroup>
            }
        </select>
    </label>
    <label class="control">
        <span class="range-label"><span>@L["use.thickness"]</span><output>@thickness mm</output></span>
        <input type="range" min="1" max="50" step="1" @bind="thickness" />
    </label>
    <label class="control">
        <span class="range-label"><span>@L["use.frost"]</span><output>@blur px</output></span>
        <input type="range" min="0" max="30" step="1" @bind="blur" />
    </label>
</div>

@if (glass is { } g0 && tint is { } c)
{
    <h2>@L["use.ui.h"]</h2>
    <p>@T("use.ui.p", g0.VendorDisplayName, g0.Name, thickness)</p>
    <div class="use-demo">
        <div class="use-backdrop">
            <span style="background:#e4572e"></span><span style="background:#17bebb"></span><span style="background:#ffc914"></span><span style="background:#2e282a"></span><span style="background:#76b041"></span>
            <p>@L["use.demo.text"]</p>
        </div>
        <div class="glass-panel" style="@PanelStyle">
            <strong>@g0.Name</strong>
            <span>@thickness mm · n<sub>d</sub> @SiteInfo.Number(g0.IndexD, 4) · Y @SiteInfo.Number(c.Y, 3)</span>
        </div>
    </div>
    <div class="snippet">
        <div class="snippet-bar"><span>@L["use.css.label"]</span><button @onclick="() => Copy(cssSnippet)">@L["use.copy"]</button></div>
        <pre><code>@cssSnippet</code></pre>
    </div>
    <p class="muted">@H("use.css.note")</p>

    <h2>@L["use.glsl.h"]</h2>
    <p>@L["use.glsl.p"]</p>
    <div class="snippet">
        <div class="snippet-bar"><span>GLSL</span><button @onclick="() => Copy(glslSnippet)">@L["use.copy"]</button></div>
        <pre><code>@glslSnippet</code></pre>
    </div>

    <h2>@L["use.cs.h"]</h2>
    <p>@L["use.cs.p"]</p>
    <div class="snippet">
        <div class="snippet-bar"><span>C#</span><button @onclick="() => Copy(csharpSnippet)">@L["use.copy"]</button></div>
        <pre><code>@csharpSnippet</code></pre>
    </div>

    <h2>@L["use.which.h"]</h2>
    <div class="columns">
        <div><h3>@L["use.which.ui.h"]</h3><p>@L["use.which.ui.p"]</p></div>
        <div><h3>@L["use.which.glsl.h"]</h3><p>@L["use.which.glsl.p"]</p></div>
        <div><h3>@L["use.which.cs.h"]</h3><p>@L["use.which.cs.p"]</p></div>
    </div>
}

@code {
    private static readonly (string Key, string Label)[] Featured =
    [
        ("schott/N-BK7", "SCHOTT N-BK7 — the crown everything is measured against"),
        ("schott/N-SF11", "SCHOTT N-SF11 — dense flint, strong fringes"),
        ("schott/SF57", "SCHOTT SF57 — very dense flint, warm when thick"),
        ("schott/N-SF66", "SCHOTT N-SF66 — the highest dispersion in the catalog"),
        ("schott/N-LASF9", "SCHOTT N-LASF9 — high index, tight refraction"),
        ("schott/N-FK58", "SCHOTT N-FK58 — fluor crown, almost no fringes"),
        ("ohara/S-FPL53", "OHARA S-FPL53 — extra-low dispersion"),
        ("ohara/S-LAH79", "OHARA S-LAH79 — index above two"),
        ("hoya/TAFD55", "HOYA TAFD55 — high-index lanthanum flint"),
        ("cdgm/H-ZF88", "CDGM H-ZF88 — dense flint"),
    ];

    private string selectedKeyValue = "schott/N-BK7";
    private double thicknessValue = 6;
    private double blurValue = 10;
    private Glass? glass;
    private TransmittedColour? tint;
    private string cssSnippet = "", glslSnippet = "", csharpSnippet = "";
    private double faceReflectance, edgeReflectance, shift, fringe;

    private string selectedKey { get => selectedKeyValue; set { selectedKeyValue = value; Recompute(); } }
    private double thickness { get => thicknessValue; set { thicknessValue = value; Recompute(); } }
    private double blur { get => blurValue; set { blurValue = value; Recompute(); } }

    protected override void OnInitialized() => Recompute();

    private string PanelStyle => tint is { } c
        ? $"--glass-tint:{c.Hex};--glass-edge:{F(edgeReflectance, 3)};--glass-face:{F(faceReflectance, 3)};--glass-blur:{blurValue}px"
        : "";

    private void Recompute()
    {
        int slash = selectedKeyValue.IndexOf('/');
        glass = slash > 0 ? GlassCatalog.Find(selectedKeyValue[..slash], selectedKeyValue[(slash + 1)..]) : null;
        if (glass is null)
        {
            tint = null;
            return;
        }

        tint = GlassColour.Transmitted(glass, thicknessValue);
        double nd = glass.IndexD;
        faceReflectance = Dielectric.NormalReflectance(1f, (float)nd);
        edgeReflectance = Dielectric.Fresnel((float)Math.Cos(75d * Math.PI / 180d), 1f, (float)nd).Unpolarized;
        double shiftRed = Shift(IndexAt(700d));
        double shiftBlue = Shift(IndexAt(400d));
        shift = Shift(nd);
        fringe = shiftBlue - shiftRed;

        TransmittedColour c = tint ?? default;
        cssSnippet = $$"""
        /* {{glass.VendorDisplayName}} {{glass.Name}}, {{thicknessValue}} mm. Values from Caustikon.Glasses; provenance: {{glass.Provenance.Citation}} */
        :root {
          --glass-index: {{F(nd, 5)}};          /* n_d */
          --glass-tint: {{c.Hex}};          /* D65 after {{thicknessValue}} mm, sRGB */
          --glass-luminance: {{F(c.Y, 4)}};     /* luminous transmittance of that path */
          --glass-face: {{F(faceReflectance, 4)}};        /* reflectance at normal incidence */
          --glass-edge: {{F(edgeReflectance, 4)}};        /* reflectance at 75° incidence */
          --glass-shift: {{F(shift, 4)}};       /* ray displacement per unit thickness, 45° */
          --glass-fringe: {{F(fringe, 5)}};     /* blue–red difference of that displacement */
        }

        .glass {
          position: relative;
          background: color-mix(in srgb, var(--glass-tint) 30%, transparent);
          -webkit-backdrop-filter: blur({{blurValue}}px);
          backdrop-filter: blur({{blurValue}}px);                     /* frost: a design choice, not the glass */
          border: 1px solid rgb(255 255 255 / var(--glass-edge));
          box-shadow: inset 0 1px 0 rgb(255 255 255 / calc(var(--glass-face) * 3)),
                      0 12px 32px rgb(0 0 0 / 0.18);
          border-radius: 16px;
        }
        """;

        glslSnippet = $$"""
        // {{glass.VendorDisplayName}} {{glass.Name}} — Caustikon.Glasses, {{glass.Provenance.Citation}}
        // Refractive index for a wavelength in micrometers, valid {{F(glass.Model.MinimumWavelengthNanometers / 1000d, 3)}}–{{F(glass.Model.MaximumWavelengthNanometers / 1000d, 3)}} µm.
        float caustikonIor(float lambda) {
        {{FormulaBody(glass)}}
        }

        // Index and absorption per millimetre at 610, 550 and 465 nm, for renderers that trace three channels.
        const vec3 caustikonIorRgb = vec3({{F(IndexAt(610d), 5)}}, {{F(IndexAt(550d), 5)}}, {{F(IndexAt(465d), 5)}});
        const vec3 caustikonAbsorbPerMm = vec3({{F(Absorb(610d), 6)}}, {{F(Absorb(550d), 6)}}, {{F(Absorb(465d), 6)}});
        vec3 caustikonTransmit(float pathMm) { return exp(-caustikonAbsorbPerMm * pathMm); }

        // Exact unpolarized Fresnel power reflectance; returns 1.0 beyond the critical angle.
        float caustikonFresnel(float cosI, float nI, float nT) {
          float eta = nI / nT;
          float sinT2 = eta * eta * (1.0 - cosI * cosI);
          if (sinT2 >= 1.0) return 1.0;
          float cosT = sqrt(1.0 - sinT2);
          float rs = (nI * cosI - nT * cosT) / (nI * cosI + nT * cosT);
          float rp = (nT * cosI - nI * cosT) / (nT * cosI + nI * cosT);
          return 0.5 * (rs * rs + rp * rp);
        }
        """;

        string identifier = Identifier(glass.Name);
        string vendorClass = char.ToUpperInvariant(glass.Vendor[0]) + glass.Vendor[1..];
        csharpSnippet = $$"""
        // dotnet add package Caustikon.Glasses
        using Caustikon;
        using Caustikon.Glasses;

        {{ModelType(glass)}} model = {{vendorClass}}.{{identifier}};               // value type, allocation-free
        model.EvaluateNanometers(587.5618, out double nd);   // {{F(nd, 5)}}

        Glass glass = GlassCatalog.Find("{{glass.Vendor}}", "{{glass.Name}}")!;
        glass.Extinction!.InternalTransmittance(450, {{thicknessValue}}, out double t450);   // {{Tau(450d)}}
        TransmittedColour tint = GlassColour.Transmitted(glass, {{thicknessValue}})!.Value;    // {{c.Hex}}, Y {{F(c.Y, 4)}}
        FresnelPower rim = Dielectric.Fresnel(cosIncident: 0.2588f, 1f, (float)nd);   // 75°: {{F(edgeReflectance, 4)}}
        """;
    }

    private double IndexAt(double wavelength)
    {
        IDispersionModel model = glass!.Model;
        double clamped = Math.Clamp(wavelength, model.MinimumWavelengthNanometers, model.MaximumWavelengthNanometers);
        return model.EvaluateNanometers(clamped, out double n) == DispersionStatus.Success ? n : double.NaN;
    }

    private double Absorb(double wavelength)
    {
        if (glass!.Extinction is not { } extinction)
        {
            return 0d;
        }

        double clamped = Math.Clamp(wavelength, extinction.MinimumWavelengthNanometers, extinction.MaximumWavelengthNanometers);
        extinction.AbsorptionCoefficient(clamped, out double perMeter);
        return perMeter * 1e-3d;
    }

    private string Tau(double wavelength)
    {
        if (glass!.Extinction is not { } extinction)
        {
            return "no k data";
        }

        double clamped = Math.Clamp(wavelength, extinction.MinimumWavelengthNanometers, extinction.MaximumWavelengthNanometers);
        extinction.InternalTransmittance(clamped, thicknessValue, out double t);
        return F(t, 4);
    }

    // Lateral shift of a ray through a plane slab at 45°, per unit thickness: sin θ · (1 − cos θ / sqrt(n² − sin² θ)).
    private static double Shift(double n)
    {
        double s = Math.Sin(Math.PI / 4), c = Math.Cos(Math.PI / 4);
        return s * (1d - c / Math.Sqrt(n * n - s * s));
    }

    private static string FormulaBody(Glass glass)
    {
        switch (glass.Model)
        {
            case Sellmeier m:
            {
                System.Text.StringBuilder b = new("  float l2 = lambda * lambda;\n  float n2 = 1.0 + " + G(m.Offset));
                for (int i = 0; i < m.TermCount; i++)
                {
                    b.Append("\n    + ").Append(G(m.StrengthAt(i))).Append(" * l2 / (l2 - ").Append(G(m.ResonanceUm2At(i))).Append(')');
                }

                return b.Append(";\n  return sqrt(n2);").ToString();
            }
            case Polynomial m:
            {
                System.Text.StringBuilder b = new("  float n2 = " + G(m.Offset));
                for (int i = 0; i < m.TermCount; i++)
                {
                    b.Append("\n    + ").Append(G(m.CoefficientAt(i))).Append(" * pow(lambda, ").Append(G(m.ExponentAt(i))).Append(')');
                }

                return b.Append(";\n  return sqrt(n2);").ToString();
            }
            case Cauchy m:
            {
                System.Text.StringBuilder b = new("  float n = " + G(m.Offset));
                for (int i = 0; i < m.TermCount; i++)
                {
                    b.Append("\n    + ").Append(G(m.CoefficientAt(i))).Append(" * pow(lambda, ").Append(G(m.ExponentAt(i))).Append(')');
                }

                return b.Append(";\n  return n;").ToString();
            }
            default:
                return "  return 1.5;";
        }
    }

    private static string ModelType(Glass glass) => glass.Model switch { Sellmeier => "Sellmeier", Polynomial => "Polynomial", Cauchy => "Cauchy", _ => "IDispersionModel" };

    private static string Identifier(string name)
    {
        string id = new(name.Where(char.IsAsciiLetterOrDigit).ToArray());
        return id.Length > 0 && char.IsAsciiDigit(id[0]) ? "G" + id : id;
    }

    private static string G(double value)
    {
        string text = value.ToString("R", CultureInfo.InvariantCulture);
        if (!text.Contains('.') && !text.Contains('E') && !text.Contains('e'))
        {
            text += ".0";
        }

        return text;
    }

    private static string F(double value, int decimals) => double.IsNaN(value) ? "NaN" : value.ToString("F" + decimals, CultureInfo.InvariantCulture);

    private async Task Copy(string text) => await Js.InvokeVoidAsync("caustikonClipboard.copy", text);
}
