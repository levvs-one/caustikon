@page "/"
@using System.Numerics
@using Caustikon.Site.Services
@inherits LocalizedComponent

<PageTitle>@L["home.title"]</PageTitle>

<div class="hero-text">
    <h1>@L["home.h1"]</h1>
    <p class="lede">@T("home.lede", SiteInfo.GlassCount)</p>
</div>

<div class="bench-layout">
    <div class="bench-main">
        <PrismScene Glass="prismGlass" Vertices="vertices" BeamAngleDegrees="beamAngle" BeamHeight="beamHeight" RayCount="rayCount" Zoom="zoom"
                    MillimetersPerUnit="mmPerUnit" MediumIndex="MediumIndexValue" TemperatureCelsius="temperature" ShowReflections="reflections"
                    Editable="editing" VerticesChanged="OnVerticesChanged" Traced="OnTraced" />
        <div class="readout compact">
            <div><div class="value">@SiteInfo.Number(minDeviation, 2)°</div><div class="label">@L["home.readout.min"]</div></div>
            <div><div class="value">@SiteInfo.Number(maxDeviation, 2)°</div><div class="label">@L["home.readout.max"]</div></div>
            <div><div class="value">@SiteInfo.Number(maxDeviation - minDeviation, 3)°</div><div class="label">@L["home.readout.spread"]</div></div>
            <div><div class="value">@SiteInfo.Number(double.IsNaN(maxDeviation) ? double.NaN : 1000 * Math.Tan((maxDeviation - minDeviation) * Math.PI / 180), 0) mm</div><div class="label">@L["home.readout.screen"]</div></div>
            <div><div class="value">@SiteInfo.Number(energyOut * 100, 1)%</div><div class="label">@L["home.readout.energy"]</div></div>
            <div><div class="value">@SiteInfo.Number(energyReflected * 100, 1)%</div><div class="label">@L["home.readout.reflected"]</div></div>
            <div><div class="value">@SiteInfo.Number(energyAbsorbed * 100, 2)%</div><div class="label">@L["home.readout.absorbed"]</div></div>
        </div>
        <p class="muted small">@L["home.bench.note"]</p>
    </div>
    <aside class="bench-aside panel compact">
        <div class="group">
            <h4>@L["home.group.element"]</h4>
            <label class="control">
                <span>@L["home.bench.glass"]</span>
                <select @bind="prismKey">
                    <optgroup label="@L["render.common"]">
                        @foreach ((string key, string label) in PrismChoices)
                        {
                            <option value="@key">@label</option>
                        }
                    </optgroup>
                    @foreach (string vendor in GlassCatalog.Vendors)
                    {
                        <optgroup label="@(GlassCatalog.ByVendor(vendor).First().VendorDisplayName)">
                            @foreach (Glass g in GlassCatalog.ByVendor(vendor).Where(g => g.CatalogIndexD is not null))
                            {
                                <option value="@(g.Vendor + "/" + g.Name)">@g.Name</option>
                            }
                        </optgroup>
                    }
                </select>
            </label>
            <label class="control">
                <span>@L["home.bench.shape"]</span>
                <select @bind="shape">
                    <option value="biconvex">@L["home.shape.biconvex"]</option>
                    <option value="planoconvex">@L["home.shape.planoconvex"]</option>
                    <option value="biconcave">@L["home.shape.biconcave"]</option>
                    <option value="meniscus">@L["home.shape.meniscus"]</option>
                    <option value="polygon">@L["home.shape.polygon"]</option>
                    <option value="rightangle">@L["home.shape.rightangle"]</option>
                    <option value="plate">@L["home.shape.plate"]</option>
                    <option value="custom">@L["home.shape.custom"]</option>
                </select>
            </label>
            @if (shape is "biconvex" or "planoconvex" or "biconcave" or "meniscus" or "custom-lens")
            {
                <label class="control">
                    <span class="range-label"><span>@L["home.lens.left"]</span><output>@F(leftCurvature, 2)</output></span>
                    <input type="range" min="-3" max="3" step="0.05" @bind="leftCurvature" @bind:event="oninput" />
                </label>
                <label class="control">
                    <span class="range-label"><span>@L["home.lens.right"]</span><output>@F(rightCurvature, 2)</output></span>
                    <input type="range" min="-3" max="3" step="0.05" @bind="rightCurvature" @bind:event="oninput" />
                </label>
                <label class="control">
                    <span class="range-label"><span>@L["home.lens.thickness"]</span><output>@F(lensThickness * mmPerUnit, 1) mm</output></span>
                    <input type="range" min="0.02" max="0.8" step="0.01" @bind="lensThickness" @bind:event="oninput" />
                </label>
            }
            @if (shape == "polygon")
            {
                <label class="control">
                    <span class="range-label"><span>@L["home.bench.corners"]</span><output>@sides</output></span>
                    <input type="range" min="3" max="12" step="1" @bind="sides" @bind:event="oninput" />
                </label>
                <label class="control">
                    <span class="range-label"><span>@L["home.polygon.rotation"]</span><output>@rotation°</output></span>
                    <input type="range" min="0" max="180" step="1" @bind="rotation" @bind:event="oninput" />
                </label>
            }
            @if (shape == "plate")
            {
                <label class="control">
                    <span class="range-label"><span>@L["home.plate.tilt"]</span><output>@plateTilt°</output></span>
                    <input type="range" min="-60" max="60" step="1" @bind="plateTilt" @bind:event="oninput" />
                </label>
                <label class="control">
                    <span class="range-label"><span>@L["home.lens.thickness"]</span><output>@F(plateThickness * mmPerUnit, 1) mm</output></span>
                    <input type="range" min="0.05" max="0.6" step="0.01" @bind="plateThickness" @bind:event="oninput" />
                </label>
            }
            <label class="control">
                <span class="range-label"><span>@L["home.size"]</span><output>@F(sizeFactor * baseHeightMm(), 0) mm</output></span>
                <input type="range" min="0.3" max="2" step="0.02" @bind="sizeFactor" @bind:event="oninput" />
            </label>
            <label class="control">
                <span class="range-label"><span>@L["home.height"]</span><output>×@F(heightFactor, 2)</output></span>
                <input type="range" min="0.3" max="2.5" step="0.02" @bind="heightFactor" @bind:event="oninput" />
            </label>
            <div class="control">
                <label class="check"><input type="checkbox" @bind="editing" /> @L["home.bench.drag"]</label>
                @if (editing)
                {
                    <div class="button-row">
                        <button @onclick="AddCorner">@L["home.bench.add"]</button>
                        <button @onclick="RemoveCorner" disabled="@(vertices.Length <= 3)">@L["home.bench.remove"]</button>
                        <button @onclick="ResetShape">@L["home.bench.reset"]</button>
                    </div>
                }
            </div>
        </div>
        <div class="group">
            <h4>@L["home.group.beam"]</h4>
            <label class="control">
                <span class="range-label"><span>@L["home.bench.angle"]</span><output>@beamAngle°</output></span>
                <input type="range" min="-35" max="35" step="0.5" @bind="beamAngle" @bind:event="oninput" />
            </label>
            <label class="control">
                <span class="range-label"><span>@L["home.bench.height"]</span><output>@F(beamHeight * mmPerUnit, 1) mm</output></span>
                <input type="range" min="-0.6" max="1.2" step="0.01" @bind="beamHeight" @bind:event="oninput" />
            </label>
            <label class="control">
                <span class="range-label"><span>@L["home.rays"]</span><output>@rayCount</output></span>
                <input type="range" min="1" max="121" step="2" @bind="rayCount" @bind:event="oninput" />
            </label>
            <label class="check"><input type="checkbox" @bind="reflections" /> @L["home.reflections"]</label>
        </div>
        <div class="group">
            <h4>@L["home.group.physics"]</h4>
            <label class="control">
                <span>@L["home.medium"]</span>
                <select @bind="medium">
                    @foreach ((string key, string label, double index) in Media)
                    {
                        <option value="@key">@(L.IsRussian ? label.Split('|')[1] : label.Split('|')[0]) · n @F(index, 4)</option>
                    }
                </select>
            </label>
            <label class="control">
                <span class="range-label"><span>@L["home.temperature"]</span><output>@temperature °C@(prismGlass.Thermal is null ? " · " + L["home.thermal.none"] : "")</output></span>
                <input type="range" min="-40" max="80" step="1" @bind="temperature" @bind:event="oninput" />
            </label>
            <label class="control">
                <span class="range-label"><span>@L["home.scale"]</span><output>@F(mmPerUnit, 0) mm</output></span>
                <input type="range" min="5" max="200" step="5" @bind="mmPerUnit" @bind:event="oninput" />
            </label>
        </div>
        <div class="group">
            <h4>@L["home.group.view"]</h4>
            <label class="control">
                <span class="range-label"><span>@L["home.zoom"]</span><output>×@F(zoom, 2)</output></span>
                <input type="range" min="0.5" max="4" step="0.05" @bind="zoom" @bind:event="oninput" />
            </label>
        </div>
    </aside>
</div>

<h2>@L["calc.h"]</h2>
<p class="lede">@L["calc.lede"]</p>
<OpticsCalculator />

<h2>@L["home.what.h"]</h2>
<p>@H("home.what.p1", SiteInfo.GlassCount, SiteInfo.VendorCount, withExtinction, withThermal)</p>
<p>@H("home.what.p2")</p>

<h2>@L["home.map.h"]</h2>
<dl class="kv map">
    <dt><a href="catalog">@L["nav.catalog"]</a></dt><dd>@T("home.map.catalog", SiteInfo.GlassCount)</dd>
    <dt><a href="playground">@L["nav.playground"]</a></dt><dd>@L["home.map.playground"]</dd>
    <dt><a href="render">@L["nav.render"]</a></dt><dd>@L["home.map.render"]</dd>
    <dt><a href="use">@L["nav.use"]</a></dt><dd>@L["home.map.use"]</dd>
    <dt><a href="formulas">@L["nav.formulas"]</a></dt><dd>@L["home.map.formulas"]</dd>
    <dt><a href="about">@L["nav.about"]</a></dt><dd>@L["home.map.about"]</dd>
</dl>

<h2>@L["home.install.h"]</h2>
<pre><code>dotnet add package Caustikon
dotnet add package Caustikon.Glasses</code></pre>
<p>@L["home.install.p"]</p>

<h2>@L["home.use.h"]</h2>
<pre><code>using Caustikon;
using Caustikon.Glasses;

// The concrete model is a value type: no allocation on the ray path.
Sellmeier bk7 = Schott.NBK7;
bk7.EvaluateNanometers(587.5618, out double nd);          // @SiteInfo.Number(nd, 5)

// Refraction and exact reflectance at an air–glass interface.
Vector3 incident = Vector3.Normalize(new Vector3(0.5f, -0.866f, 0f));
RefractionKind kind = Dielectric.RefractUnit(incident, Vector3.UnitY, 1f, (float)nd, out Vector3 transmitted);
FresnelPower r = Dielectric.Fresnel(0.866f, 1f, (float)nd);   // s @SiteInfo.Number(rs, 4), p @SiteInfo.Number(rp, 4)

// By name, with everything the catalog knows about it.
Glass glass = GlassCatalog.Find("ohara", "S-BSL7")!;
glass.Extinction!.InternalTransmittance(400, 10, out double t);   // @SiteInfo.Number(tau, 4)
string tint = GlassColour.Transmitted(glass, 25)!.Value.Hex;      // @tintHex</code></pre>
<p>@L["home.use.p"]</p>

@code {
    private static readonly (string Key, string Label)[] PrismChoices =
    [
        ("schott/N-BK7", "SCHOTT N-BK7 — νd 64"),
        ("schott/N-FK58", "SCHOTT N-FK58 — νd 91"),
        ("schott/N-LASF9", "SCHOTT N-LASF9 — νd 32"),
        ("schott/SF57", "SCHOTT SF57 — νd 24"),
        ("schott/N-SF66", "SCHOTT N-SF66 — νd 21"),
        ("ohara/S-FPL53", "OHARA S-FPL53 — νd 95"),
        ("hoya/TAFD55", "HOYA TAFD55 — νd 27"),
        ("cdgm/H-ZF88", "CDGM H-ZF88 — νd 20"),
    ];

    // Surrounding media at the d line, 20 °C: gases from Ciddor/Edlén-type data, liquids from standard tables.
    private static readonly (string Key, string Label, double Index)[] Media =
    [
        ("vacuum", "vacuum|вакуум", 1.0),
        ("air", "air|воздух", 1.000273),
        ("helium", "helium|гелий", 1.000035),
        ("co2", "carbon dioxide|углекислый газ", 1.000449),
        ("water", "water|вода", 1.3330),
        ("ethanol", "ethanol|этанол", 1.3614),
        ("glycerol", "glycerol|глицерин", 1.4730),
        ("benzene", "benzene|бензол", 1.5011),
        ("oil", "immersion oil|иммерсионное масло", 1.5150),
        ("cs2", "carbon disulfide|сероуглерод", 1.6276),
    ];

    private int withExtinction;
    private int withThermal;
    private double nd, rs, rp, tau;
    private string tintHex = "";
    private string prismKeyValue = "schott/N-BK7";
    private string shapeValue = "biconvex";
    private bool editing;
    private int sidesValue = 3;
    private double rotationValue = 0;
    private double leftCurvatureValue = 1.3, rightCurvatureValue = 1.3, lensThicknessValue = 0.16;
    private double plateTiltValue = 20, plateThicknessValue = 0.22;
    private double sizeFactorValue = 1, heightFactorValue = 1;
    private double beamAngle = 0;
    private double beamHeight = 0.25;
    private int rayCount = 61;
    private double zoom = 1;
    private double mmPerUnit = 25;
    private string medium = "air";
    private double temperature = 20;
    private bool reflections = true;
    private Glass prismGlass = GlassCatalog.Find("schott", "N-BK7")!;
    private double minDeviation = double.NaN, maxDeviation = double.NaN, energyOut = double.NaN, energyAbsorbed = double.NaN, energyReflected = double.NaN;
    private Vector2[] vertices = [];
    private Vector2[] baseVertices = [];

    private double MediumIndexValue => Media.First(m => m.Key == medium).Index;

    private string prismKey
    {
        get => prismKeyValue;
        set
        {
            prismKeyValue = value;
            int slash = value.IndexOf('/');
            prismGlass = GlassCatalog.Find(value[..slash], value[(slash + 1)..]) ?? prismGlass;
        }
    }

    private string shape { get => shapeValue; set { shapeValue = value; ApplyPreset(); } }
    private int sides { get => sidesValue; set { sidesValue = value; Rebuild(); } }
    private double rotation { get => rotationValue; set { rotationValue = value; Rebuild(); } }
    private double leftCurvature { get => leftCurvatureValue; set { leftCurvatureValue = value; Rebuild(); } }
    private double rightCurvature { get => rightCurvatureValue; set { rightCurvatureValue = value; Rebuild(); } }
    private double lensThickness { get => lensThicknessValue; set { lensThicknessValue = value; Rebuild(); } }
    private double plateTilt { get => plateTiltValue; set { plateTiltValue = value; Rebuild(); } }
    private double plateThickness { get => plateThicknessValue; set { plateThicknessValue = value; Rebuild(); } }
    private double sizeFactor { get => sizeFactorValue; set { sizeFactorValue = value; Rebuild(); } }
    private double heightFactor { get => heightFactorValue; set { heightFactorValue = value; Rebuild(); } }

    private double baseHeightMm() => 0.9 * mmPerUnit;

    private void ApplyPreset()
    {
        switch (shapeValue)
        {
            case "biconvex": leftCurvatureValue = 1.3; rightCurvatureValue = 1.3; lensThicknessValue = 0.16; break;
            case "planoconvex": leftCurvatureValue = 0; rightCurvatureValue = 1.6; lensThicknessValue = 0.14; break;
            case "biconcave": leftCurvatureValue = -1.3; rightCurvatureValue = -1.3; lensThicknessValue = 0.1; break;
            case "meniscus": leftCurvatureValue = 1.8; rightCurvatureValue = -1.1; lensThicknessValue = 0.12; break;
        }

        Rebuild();
    }

    private void Rebuild()
    {
        if (shapeValue == "custom")
        {
            if (vertices.Length == 0)
            {
                vertices = BenchShapes.Polygon(4, 0.5f, 45f);
            }

            baseVertices = vertices;
            return;
        }

        baseVertices = shapeValue switch
        {
            "polygon" => BenchShapes.Polygon(sidesValue, 0.55f, (float)rotationValue),
            "rightangle" => BenchShapes.RightAnglePrism(),
            "plate" => BenchShapes.Plate((float)plateTiltValue, (float)plateThicknessValue),
            _ => BenchShapes.Lens((float)leftCurvatureValue, (float)rightCurvatureValue, (float)lensThicknessValue, 0.9f),
        };
        // Centre the element on the bench, then apply size and height; the beam passes at y ≈ 0.25 by default.
        Vector2[] placed = BenchShapes.Scaled(baseVertices, (float)sizeFactorValue, (float)heightFactorValue);
        vertices = placed.Select(v => v + new Vector2(0.5f, 0.35f)).ToArray();
    }

    private void OnVerticesChanged(Vector2[] moved)
    {
        vertices = moved;
        if (shapeValue != "custom")
        {
            shapeValue = "custom";
        }
    }

    private void AddCorner()
    {
        int longest = 0;
        float best = -1;
        for (int i = 0; i < vertices.Length; i++)
        {
            float length = Vector2.Distance(vertices[i], vertices[(i + 1) % vertices.Length]);
            if (length > best)
            {
                best = length;
                longest = i;
            }
        }

        List<Vector2> list = [.. vertices];
        list.Insert(longest + 1, (vertices[longest] + vertices[(longest + 1) % vertices.Length]) / 2f);
        vertices = [.. list];
        shapeValue = "custom";
    }

    private void RemoveCorner()
    {
        if (vertices.Length > 3)
        {
            vertices = vertices[..^1];
            shapeValue = "custom";
        }
    }

    private void ResetShape()
    {
        shapeValue = "biconvex";
        ApplyPreset();
    }

    protected override void OnInitialized()
    {
        withExtinction = GlassCatalog.All.Count(g => g.Extinction is not null);
        withThermal = GlassCatalog.All.Count(g => g.Thermal is not null);
        Schott.NBK7.EvaluateNanometers(587.5618d, out nd);
        FresnelPower r = Dielectric.Fresnel(0.866f, 1f, (float)nd);
        rs = r.S;
        rp = r.P;
        Glass glass = GlassCatalog.Find("ohara", "S-BSL7")!;
        glass.Extinction!.InternalTransmittance(400d, 10d, out tau);
        tintHex = GlassColour.Transmitted(glass, 25d)!.Value.Hex;
        ApplyPreset();
    }

    private void OnTraced(PrismScene scene)
    {
        minDeviation = scene.MinimumDeviation;
        maxDeviation = scene.MaximumDeviation;
        energyOut = scene.EnergyOut;
        energyAbsorbed = scene.EnergyAbsorbed;
        energyReflected = scene.EnergyReflectedAtEntry;
        StateHasChanged();
    }

    private static string F(double v, int decimals) => v.ToString("F" + decimals, CultureInfo.InvariantCulture);
}
