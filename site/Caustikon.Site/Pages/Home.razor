@page "/"
@using System.Numerics

<PageTitle>Caustikon</PageTitle>

<div class="hero-text">
    <h1>Geometric optics for .NET, with the glass included</h1>
    <p class="lede">
        Refraction, exact Fresnel reflectance and dispersion as allocation-free value types, and a catalog of
        @SiteInfo.GlassCount manufacturer glasses with dispersion, absorption and temperature data, each number cited.
    </p>
</div>

<div class="bench-layout">
    <div class="bench-main">
        <PrismScene Glass="prismGlass" Vertices="vertices" BeamAngleDegrees="beamAngle" BeamHeight="beamHeight" Editable="editing" VerticesChanged="OnVerticesChanged" Traced="OnTraced" />
        <div class="readout">
            <div><div class="value">@SiteInfo.Number(minDeviation, 2)°</div><div class="label">smallest deviation</div></div>
            <div><div class="value">@SiteInfo.Number(maxDeviation, 2)°</div><div class="label">largest deviation</div></div>
            <div><div class="value">@SiteInfo.Number(maxDeviation - minDeviation, 2)°</div><div class="label">spread, 400–700 nm</div></div>
            <div><div class="value">@SiteInfo.Number(double.IsNaN(maxDeviation) ? double.NaN : 1000 * Math.Tan((maxDeviation - minDeviation) * Math.PI / 180), 0) mm</div><div class="label">spectrum on a screen 1 m away</div></div>
            <div><div class="value">@raysOut / 61</div><div class="label">rays that leave the glass</div></div>
        </div>
        <p class="muted">
            Sixty-one wavelengths traced through the shape with the packages' own refraction, reflected inside where the exit angle is past
            critical, each drawn in its CIE colour and added like light. The marks on the right are where they land on a screen.
        </p>
    </div>
    <aside class="bench-aside panel">
        <label class="control">
            <span>Glass</span>
            <select @bind="prismKey">
                @foreach ((string key, string label) in PrismChoices)
                {
                    <option value="@key">@label</option>
                }
            </select>
        </label>
        <label class="control">
            <span>Shape</span>
            <select @bind="shape">
                <option value="polygon">regular polygon</option>
                <option value="lens">biconvex lens</option>
                <option value="plate">tilted plate</option>
            </select>
        </label>
        @if (shape == "polygon")
        {
            <label class="control">
                <span class="range-label"><span>Corners</span><output>@sides</output></span>
                <input type="range" min="3" max="12" step="1" @bind="sides" @bind:event="oninput" />
            </label>
        }
        <label class="control">
            <span class="range-label"><span>Beam angle</span><output>@beamAngle°</output></span>
            <input type="range" min="-35" max="35" step="0.5" @bind="beamAngle" @bind:event="oninput" />
        </label>
        <label class="control">
            <span class="range-label"><span>Beam height</span><output>@beamHeight.ToString("0.00", CultureInfo.InvariantCulture)</output></span>
            <input type="range" min="-0.3" max="1.1" step="0.01" @bind="beamHeight" @bind:event="oninput" />
        </label>
        <div class="control">
            <label class="check"><input type="checkbox" @bind="editing" /> drag the corners</label>
            @if (editing)
            {
                <div class="button-row">
                    <button @onclick="AddCorner">Add a corner</button>
                    <button @onclick="RemoveCorner" disabled="@(vertices.Length <= 3)">Remove one</button>
                    <button @onclick="ResetShape">Reset</button>
                </div>
            }
        </div>
    </aside>
</div>

<h2>What this is</h2>
<p>
    I wanted a glass library that does not make me go back to the manufacturer's PDF for every coefficient, so I imported every
    manufacturer glass with a closed-form dispersion fit from the RefractiveIndex.INFO database: @SiteInfo.GlassCount glasses from
    @SiteInfo.VendorCount makers, @withExtinction of them with absorption tables and @withThermal with temperature coefficients.
    Each one carries the catalog it was transcribed from, the file it came from and the date I read it.
</p>
<p>
    I did not trust the import until I could check it, so every glass is evaluated at the exact d, F and C lines and compared with the
    n<sub>d</sub> and ν<sub>d</sub> its maker prints — numbers that do not depend on the fit — on every commit. N-BK7 I pinned further,
    to its SCHOTT datasheet for internal transmittance and dn/dT. Nothing on this site is typed in: the pages run the packages and
    show what comes out.
</p>

<h2>Where things are</h2>
<dl class="kv map">
    <dt><a href="catalog">Catalog</a></dt><dd>All @SiteInfo.GlassCount glasses on the Abbe diagram and in a filterable table; each opens to its curves, absorption, colour, temperature, coefficients and provenance.</dd>
    <dt><a href="playground">Playground</a></dt><dd>One flat interface and one slab: angle, thickness, reflectance, refraction, dispersion and the transmitted colour, all live.</dd>
    <dt><a href="render">Render</a></dt><dd>A sphere of any glass ray-traced spectrally in the browser, with the light where you put it.</dd>
    <dt><a href="use">Use it</a></dt><dd>Three ways to take a glass into your own work: CSS for interfaces, GLSL for shaders, C# for computation, with the numbers filled in.</dd>
    <dt><a href="formulas">Formulas</a></dt><dd>Every equation the packages evaluate, its conventions, and the type that implements it.</dd>
    <dt><a href="about">About</a></dt><dd>Where the data comes from, how it is checked, what is not modelled, how to cite.</dd>
</dl>

<h2>Install</h2>
<pre><code>dotnet add package Caustikon
dotnet add package Caustikon.Glasses</code></pre>
<p>Both packages target .NET 8 and .NET 10 and depend on nothing outside the base class library.</p>

<h2>Use</h2>
<pre><code>using Caustikon;
using Caustikon.Glasses;

// The concrete model is a value type: no allocation on the ray path.
Sellmeier bk7 = Schott.NBK7;
bk7.EvaluateNanometers(587.5618, out double nd);          // @SiteInfo.Number(nd, 5)

// Refraction and exact reflectance at an air–glass interface.
Vector3 incident = Vector3.Normalize(new Vector3(0.5f, -0.866f, 0f));
RefractionKind kind = Dielectric.RefractUnit(incident, Vector3.UnitY, 1f, (float)nd, out Vector3 transmitted);
FresnelPower r = Dielectric.Fresnel(0.866f, 1f, (float)nd);   // s @SiteInfo.Number(rs, 4), p @SiteInfo.Number(rp, 4)

// By name, with everything the catalog knows about it.
Glass glass = GlassCatalog.Find("ohara", "S-BSL7")!;
glass.Extinction!.InternalTransmittance(400, 10, out double t);   // @SiteInfo.Number(tau, 4)
string tint = GlassColour.Transmitted(glass, 25)!.Value.Hex;      // @tintHex</code></pre>
<p>The numbers in the comments are computed by this page from the packages.</p>

@code {
    private static readonly (string Key, string Label)[] PrismChoices =
    [
        ("schott/N-BK7", "SCHOTT N-BK7 — borosilicate crown, νd 64"),
        ("schott/N-FK58", "SCHOTT N-FK58 — fluor crown, νd 91"),
        ("schott/N-LASF9", "SCHOTT N-LASF9 — dense lanthanum flint, νd 32"),
        ("schott/SF57", "SCHOTT SF57 — dense flint, νd 24"),
        ("schott/N-SF66", "SCHOTT N-SF66 — densest flint, νd 21"),
        ("ohara/S-FPL53", "OHARA S-FPL53 — extra-low dispersion, νd 95"),
        ("hoya/TAFD55", "HOYA TAFD55 — high-index, νd 27"),
        ("cdgm/H-ZF88", "CDGM H-ZF88 — dense flint, νd 20"),
    ];

    private int withExtinction;
    private int withThermal;
    private double nd, rs, rp, tau;
    private string tintHex = "";
    private string prismKeyValue = "schott/N-BK7";
    private string shapeValue = "polygon";
    private bool editing;
    private int sidesValue = 3;
    private double beamAngle = 20;
    private double beamHeight = 0.15;
    private Glass prismGlass = GlassCatalog.Find("schott", "N-BK7")!;
    private double minDeviation = double.NaN, maxDeviation = double.NaN;
    private int raysOut;
    private Vector2[] vertices = PrismScene.RegularPolygon(3);

    private string prismKey
    {
        get => prismKeyValue;
        set
        {
            prismKeyValue = value;
            int slash = value.IndexOf('/');
            prismGlass = GlassCatalog.Find(value[..slash], value[(slash + 1)..]) ?? prismGlass;
        }
    }

    private string shape
    {
        get => shapeValue;
        set { shapeValue = value; UpdateShape(); }
    }

    private int sides
    {
        get => sidesValue;
        set { sidesValue = value; UpdateShape(); }
    }

    private void UpdateShape()
    {
        vertices = shapeValue switch
        {
            "lens" => PrismScene.Lens(),
            "plate" => PrismScene.Plate(),
            _ => PrismScene.RegularPolygon(sidesValue),
        };
    }

    private void OnVerticesChanged(Vector2[] moved) => vertices = moved;

    private void AddCorner()
    {
        // Split the longest edge at its midpoint so the new corner has room to be dragged.
        int longest = 0;
        float best = -1;
        for (int i = 0; i < vertices.Length; i++)
        {
            float length = Vector2.Distance(vertices[i], vertices[(i + 1) % vertices.Length]);
            if (length > best)
            {
                best = length;
                longest = i;
            }
        }

        List<Vector2> list = [.. vertices];
        list.Insert(longest + 1, (vertices[longest] + vertices[(longest + 1) % vertices.Length]) / 2f);
        vertices = [.. list];
    }

    private void RemoveCorner()
    {
        if (vertices.Length > 3)
        {
            vertices = vertices[..^1];
        }
    }

    private void ResetShape() => UpdateShape();

    protected override void OnInitialized()
    {
        withExtinction = GlassCatalog.All.Count(g => g.Extinction is not null);
        withThermal = GlassCatalog.All.Count(g => g.Thermal is not null);
        Schott.NBK7.EvaluateNanometers(587.5618d, out nd);
        FresnelPower r = Dielectric.Fresnel(0.866f, 1f, (float)nd);
        rs = r.S;
        rp = r.P;
        Glass glass = GlassCatalog.Find("ohara", "S-BSL7")!;
        glass.Extinction!.InternalTransmittance(400d, 10d, out tau);
        tintHex = GlassColour.Transmitted(glass, 25d)!.Value.Hex;
    }

    private void OnTraced(PrismScene scene)
    {
        minDeviation = scene.MinimumDeviation;
        maxDeviation = scene.MaximumDeviation;
        raysOut = scene.RaysThatExit;
        StateHasChanged();
    }
}
