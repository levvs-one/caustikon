@page "/"
@using System.Numerics
@inherits LocalizedComponent

<PageTitle>@L["home.title"]</PageTitle>

<div class="hero-text">
    <h1>@L["home.h1"]</h1>
    <p class="lede">@T("home.lede", SiteInfo.GlassCount)</p>
</div>

<div class="bench-layout">
    <div class="bench-main">
        <PrismScene Glass="prismGlass" Vertices="vertices" BeamAngleDegrees="beamAngle" BeamHeight="beamHeight" Editable="editing" VerticesChanged="OnVerticesChanged" Traced="OnTraced" />
        <div class="readout">
            <div><div class="value">@SiteInfo.Number(minDeviation, 2)°</div><div class="label">@L["home.readout.min"]</div></div>
            <div><div class="value">@SiteInfo.Number(maxDeviation, 2)°</div><div class="label">@L["home.readout.max"]</div></div>
            <div><div class="value">@SiteInfo.Number(maxDeviation - minDeviation, 2)°</div><div class="label">@L["home.readout.spread"]</div></div>
            <div><div class="value">@SiteInfo.Number(double.IsNaN(maxDeviation) ? double.NaN : 1000 * Math.Tan((maxDeviation - minDeviation) * Math.PI / 180), 0) mm</div><div class="label">@L["home.readout.screen"]</div></div>
            <div><div class="value">@raysOut / 61</div><div class="label">@L["home.readout.exit"]</div></div>
        </div>
        <p class="muted">@L["home.bench.note"]</p>
    </div>
    <aside class="bench-aside panel">
        <label class="control">
            <span>@L["home.bench.glass"]</span>
            <select @bind="prismKey">
                @foreach ((string key, string label) in PrismChoices)
                {
                    <option value="@key">@label</option>
                }
            </select>
        </label>
        <label class="control">
            <span>@L["home.bench.shape"]</span>
            <select @bind="shape">
                <option value="polygon">@L["home.shape.polygon"]</option>
                <option value="lens">@L["home.shape.lens"]</option>
                <option value="plate">@L["home.shape.plate"]</option>
            </select>
        </label>
        @if (shape == "polygon")
        {
            <label class="control">
                <span class="range-label"><span>@L["home.bench.corners"]</span><output>@sides</output></span>
                <input type="range" min="3" max="12" step="1" @bind="sides" @bind:event="oninput" />
            </label>
        }
        <label class="control">
            <span class="range-label"><span>@L["home.bench.angle"]</span><output>@beamAngle°</output></span>
            <input type="range" min="-35" max="35" step="0.5" @bind="beamAngle" @bind:event="oninput" />
        </label>
        <label class="control">
            <span class="range-label"><span>@L["home.bench.height"]</span><output>@beamHeight.ToString("0.00", CultureInfo.InvariantCulture)</output></span>
            <input type="range" min="-0.3" max="1.1" step="0.01" @bind="beamHeight" @bind:event="oninput" />
        </label>
        <div class="control">
            <label class="check"><input type="checkbox" @bind="editing" /> @L["home.bench.drag"]</label>
            @if (editing)
            {
                <div class="button-row">
                    <button @onclick="AddCorner">@L["home.bench.add"]</button>
                    <button @onclick="RemoveCorner" disabled="@(vertices.Length <= 3)">@L["home.bench.remove"]</button>
                    <button @onclick="ResetShape">@L["home.bench.reset"]</button>
                </div>
            }
        </div>
    </aside>
</div>

<h2>@L["calc.h"]</h2>
<p class="lede">@L["calc.lede"]</p>
<OpticsCalculator />

<h2>@L["home.what.h"]</h2>
<p>@H("home.what.p1", SiteInfo.GlassCount, SiteInfo.VendorCount, withExtinction, withThermal)</p>
<p>@H("home.what.p2")</p>

<h2>@L["home.map.h"]</h2>
<dl class="kv map">
    <dt><a href="catalog">@L["nav.catalog"]</a></dt><dd>@T("home.map.catalog", SiteInfo.GlassCount)</dd>
    <dt><a href="playground">@L["nav.playground"]</a></dt><dd>@L["home.map.playground"]</dd>
    <dt><a href="render">@L["nav.render"]</a></dt><dd>@L["home.map.render"]</dd>
    <dt><a href="use">@L["nav.use"]</a></dt><dd>@L["home.map.use"]</dd>
    <dt><a href="formulas">@L["nav.formulas"]</a></dt><dd>@L["home.map.formulas"]</dd>
    <dt><a href="about">@L["nav.about"]</a></dt><dd>@L["home.map.about"]</dd>
</dl>

<h2>@L["home.install.h"]</h2>
<pre><code>dotnet add package Caustikon
dotnet add package Caustikon.Glasses</code></pre>
<p>@L["home.install.p"]</p>

<h2>@L["home.use.h"]</h2>
<pre><code>using Caustikon;
using Caustikon.Glasses;

// The concrete model is a value type: no allocation on the ray path.
Sellmeier bk7 = Schott.NBK7;
bk7.EvaluateNanometers(587.5618, out double nd);          // @SiteInfo.Number(nd, 5)

// Refraction and exact reflectance at an air–glass interface.
Vector3 incident = Vector3.Normalize(new Vector3(0.5f, -0.866f, 0f));
RefractionKind kind = Dielectric.RefractUnit(incident, Vector3.UnitY, 1f, (float)nd, out Vector3 transmitted);
FresnelPower r = Dielectric.Fresnel(0.866f, 1f, (float)nd);   // s @SiteInfo.Number(rs, 4), p @SiteInfo.Number(rp, 4)

// By name, with everything the catalog knows about it.
Glass glass = GlassCatalog.Find("ohara", "S-BSL7")!;
glass.Extinction!.InternalTransmittance(400, 10, out double t);   // @SiteInfo.Number(tau, 4)
string tint = GlassColour.Transmitted(glass, 25)!.Value.Hex;      // @tintHex</code></pre>
<p>@L["home.use.p"]</p>

@code {
    private static readonly (string Key, string Label)[] PrismChoices =
    [
        ("schott/N-BK7", "SCHOTT N-BK7 — νd 64"),
        ("schott/N-FK58", "SCHOTT N-FK58 — νd 91"),
        ("schott/N-LASF9", "SCHOTT N-LASF9 — νd 32"),
        ("schott/SF57", "SCHOTT SF57 — νd 24"),
        ("schott/N-SF66", "SCHOTT N-SF66 — νd 21"),
        ("ohara/S-FPL53", "OHARA S-FPL53 — νd 95"),
        ("hoya/TAFD55", "HOYA TAFD55 — νd 27"),
        ("cdgm/H-ZF88", "CDGM H-ZF88 — νd 20"),
    ];

    private int withExtinction;
    private int withThermal;
    private double nd, rs, rp, tau;
    private string tintHex = "";
    private string prismKeyValue = "schott/N-BK7";
    private string shapeValue = "polygon";
    private bool editing;
    private int sidesValue = 3;
    private double beamAngle = 20;
    private double beamHeight = 0.15;
    private Glass prismGlass = GlassCatalog.Find("schott", "N-BK7")!;
    private double minDeviation = double.NaN, maxDeviation = double.NaN;
    private int raysOut;
    private Vector2[] vertices = PrismScene.RegularPolygon(3);

    private string prismKey
    {
        get => prismKeyValue;
        set
        {
            prismKeyValue = value;
            int slash = value.IndexOf('/');
            prismGlass = GlassCatalog.Find(value[..slash], value[(slash + 1)..]) ?? prismGlass;
        }
    }

    private string shape
    {
        get => shapeValue;
        set { shapeValue = value; UpdateShape(); }
    }

    private int sides
    {
        get => sidesValue;
        set { sidesValue = value; UpdateShape(); }
    }

    private void UpdateShape()
    {
        vertices = shapeValue switch
        {
            "lens" => PrismScene.Lens(),
            "plate" => PrismScene.Plate(),
            _ => PrismScene.RegularPolygon(sidesValue),
        };
    }

    private void OnVerticesChanged(Vector2[] moved) => vertices = moved;

    private void AddCorner()
    {
        // Split the longest edge at its midpoint so the new corner has room to be dragged.
        int longest = 0;
        float best = -1;
        for (int i = 0; i < vertices.Length; i++)
        {
            float length = Vector2.Distance(vertices[i], vertices[(i + 1) % vertices.Length]);
            if (length > best)
            {
                best = length;
                longest = i;
            }
        }

        List<Vector2> list = [.. vertices];
        list.Insert(longest + 1, (vertices[longest] + vertices[(longest + 1) % vertices.Length]) / 2f);
        vertices = [.. list];
    }

    private void RemoveCorner()
    {
        if (vertices.Length > 3)
        {
            vertices = vertices[..^1];
        }
    }

    private void ResetShape() => UpdateShape();

    protected override void OnInitialized()
    {
        withExtinction = GlassCatalog.All.Count(g => g.Extinction is not null);
        withThermal = GlassCatalog.All.Count(g => g.Thermal is not null);
        Schott.NBK7.EvaluateNanometers(587.5618d, out nd);
        FresnelPower r = Dielectric.Fresnel(0.866f, 1f, (float)nd);
        rs = r.S;
        rp = r.P;
        Glass glass = GlassCatalog.Find("ohara", "S-BSL7")!;
        glass.Extinction!.InternalTransmittance(400d, 10d, out tau);
        tintHex = GlassColour.Transmitted(glass, 25d)!.Value.Hex;
    }

    private void OnTraced(PrismScene scene)
    {
        minDeviation = scene.MinimumDeviation;
        maxDeviation = scene.MaximumDeviation;
        raysOut = scene.RaysThatExit;
        StateHasChanged();
    }
}
