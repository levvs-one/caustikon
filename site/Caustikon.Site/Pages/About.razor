@page "/about"
@inherits LocalizedComponent

<PageTitle>@L["about.title"]</PageTitle>

<h1>@L["about.h1"]</h1>
<p class="lede">@L["about.lede"]</p>

<h2>@L["about.data.h"]</h2>
<p>@H("about.data.p1", manifestCommit, retrieved)</p>
<p>@H("about.data.p2", totalEntries, SiteInfo.GlassCount)</p>
<p>@H("about.data.p3")</p>

<h2>@L["about.check.h"]</h2>
<p>@H("about.check.p1", SiteInfo.GlassCount)</p>
<p>@H("about.check.p2")</p>

<h2>@L["about.limits.h"]</h2>
<p>@L["about.limits.p"]</p>

<h2>@L["about.packages.h"]</h2>
<pre><code>dotnet add package Caustikon
dotnet add package Caustikon.Glasses</code></pre>
<p>@H("about.packages.p")</p>

<h2>@L["about.cite.h"]</h2>
<p>@H("about.cite.p")</p>

@code {
    private string manifestCommit = "c5c2f18";
    private string retrieved = "2026-09-05";
    private int totalEntries = 1784;

    protected override void OnInitialized()
    {
        GlassProvenance provenance = GlassCatalog.All[0].Provenance;
        int at = provenance.Source.IndexOf("commit ", StringComparison.Ordinal);
        if (at >= 0)
        {
            manifestCommit = provenance.Source[(at + 7)..].Split(',')[0];
        }

        retrieved = provenance.RetrievedOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
