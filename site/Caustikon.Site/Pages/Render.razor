@page "/render"
@using Caustikon.Site.Services
@using System.Numerics
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Render · Caustikon</PageTitle>

<h1>Render</h1>
<p class="lede">A solid of the chosen glass on a patterned ground, ray-traced in your browser with the packages' own refraction, reflectance and absorption at nine wavelengths. The fringes and the tint are computed, not drawn.</p>

<div class="render-stage">
    <div class="render-main">
        <canvas id="render-canvas" width="@lastSize" height="@lastSize" class="render-canvas"></canvas>
        @if (glass is { } g0)
        {
            <div class="render-facts">
                <dl class="kv">
                    <dt>Glass</dt><dd>@g0.VendorDisplayName <a href="@Catalog.GlassLink(g0)">@g0.Name</a> · n<sub>d</sub> @SiteInfo.Number(g0.IndexD, 5) · ν<sub>d</sub> @SiteInfo.Number(g0.AbbeD, 2)</dd>
                    <dt>n at 400 and 700 nm</dt><dd>@IndexAt(g0, 400) · @IndexAt(g0, 700)</dd>
                    <dt>τ<sub>i</sub> across @sizeMm mm at 450 / 650 nm</dt><dd>@Tau(g0, 450) / @Tau(g0, 650)</dd>
                    <dt>Ground pattern</dt><dd>16 mm tiles, so the solid's size reads against them</dd>
                    <dt>Sampled wavelengths</dt><dd>@string.Join(", ", GlassRenderer.SampledWavelengths.Select(w => w.ToString("0", CultureInfo.InvariantCulture))) nm</dd>
                    @if (lastMilliseconds > 0)
                    {
                        <dt>Tracing time</dt><dd>@lastSize × @lastSize in @((lastMilliseconds / 1000.0).ToString("0.0", CultureInfo.InvariantCulture)) s; @refinedPixels edge pixels supersampled</dd>
                    }
                </dl>
                <p class="muted">
                    Each pixel traces nine rays, one per wavelength: Fresnel-weighted reflection off the surface, refraction in, up to six
                    internal reflections with Beer–Lambert absorption over every chord from the glass's k(λ) table, refraction out.
                    A flint spreads pattern edges into colour; a thick dense flint goes warm because its own k(λ) says so.
                    Not simulated: shadows, caustics on the ground, coatings, polarization beyond the unpolarized split.
                </p>
            </div>
        }
    </div>
    <aside class="render-aside panel">
        <label class="control">
            <span>Glass</span>
            <select @bind="selectedKey">
                <optgroup label="Commonly used">
                    @foreach ((string key, string label) in Featured)
                    {
                        <option value="@key">@label</option>
                    }
                </optgroup>
                @foreach (string vendor in GlassCatalog.Vendors)
                {
                    <optgroup label="@(GlassCatalog.ByVendor(vendor).First().VendorDisplayName)">
                        @foreach (Glass g in GlassCatalog.ByVendor(vendor).Where(g => g.CatalogIndexD is not null))
                        {
                            <option value="@(g.Vendor + "/" + g.Name)">@g.Name (@SiteInfo.Number(g.CatalogIndexD!.Value, 4) / @SiteInfo.Number(g.CatalogAbbeD ?? double.NaN, 1))</option>
                        }
                    </optgroup>
                }
            </select>
        </label>
        <label class="control">
            <span>Solid</span>
            <select @bind="shapeKey">
                <option value="sphere">sphere</option>
                <option value="cube">cube</option>
                <option value="prism">prism</option>
                <option value="octahedron">octahedron</option>
                <option value="dodecahedron">dodecahedron</option>
                <option value="icosahedron">icosahedron</option>
            </select>
        </label>
        @if (shapeKey == "prism")
        {
            <label class="control">
                <span class="range-label"><span>Prism faces</span><output>@sides</output></span>
                <input type="range" min="3" max="12" step="1" @bind="sides" />
            </label>
        }
        <label class="control">
            <span class="range-label"><span>Size</span><output>@sizeMm mm</output></span>
            <input type="range" min="10" max="200" step="5" @bind="sizeMm" />
        </label>
        <label class="control">
            <span>Backdrop</span>
            <select @bind="backdropKey">
                <option value="checker">checker</option>
                <option value="stripes">colour bands</option>
                <option value="grid">millimetre paper</option>
                <option value="paper">plain paper</option>
                <option value="night">night</option>
            </select>
        </label>
        <label class="control">
            <span class="range-label"><span>Light around</span><output>@lightAzimuth°</output></span>
            <input type="range" min="-180" max="180" step="5" @bind="lightAzimuth" />
        </label>
        <label class="control">
            <span class="range-label"><span>Light height</span><output>@lightElevation°</output></span>
            <input type="range" min="5" max="85" step="5" @bind="lightElevation" />
        </label>
        <label class="control">
            <span class="range-label"><span>Lamp</span><output>@lightIntensity.ToString("0.0", CultureInfo.InvariantCulture)×</output></span>
            <input type="range" min="0" max="3" step="0.1" @bind="lightIntensity" />
        </label>
        <label class="control">
            <span class="range-label"><span>Room</span><output>@ambient.ToString("0.0", CultureInfo.InvariantCulture)×</output></span>
            <input type="range" min="0" max="2" step="0.1" @bind="ambient" />
        </label>
        <label class="control">
            <span>Resolution</span>
            <select @bind="size">
                <option value="320">320 px</option>
                <option value="480">480 px</option>
                <option value="720">720 px</option>
            </select>
        </label>
        <button class="primary" @onclick="Start" disabled="@rendering">@(rendering ? $"Rendering… {progress}%" : "Render")</button>
    </aside>
</div>

@code {
    private static readonly (string Key, string Label)[] Featured =
    [
        ("schott/N-BK7", "SCHOTT N-BK7 — the crown everything is measured against"),
        ("schott/N-SF11", "SCHOTT N-SF11 — dense flint, strong fringes"),
        ("schott/SF57", "SCHOTT SF57 — very dense flint, warm when thick"),
        ("schott/N-SF66", "SCHOTT N-SF66 — the highest dispersion in the catalog"),
        ("schott/N-LASF9", "SCHOTT N-LASF9 — high index, tight refraction"),
        ("schott/N-FK58", "SCHOTT N-FK58 — fluor crown, almost no fringes"),
        ("ohara/S-FPL53", "OHARA S-FPL53 — extra-low dispersion"),
        ("ohara/S-LAH79", "OHARA S-LAH79 — index above two"),
        ("hoya/TAFD55", "HOYA TAFD55 — high-index lanthanum flint"),
        ("cdgm/H-ZF88", "CDGM H-ZF88 — dense flint"),
    ];

    private string selectedKeyValue = "schott/N-SF11";
    private string shapeKey = "sphere";
    private string backdropKey = "checker";
    private int sides = 6;
    private double sizeMm = 60;
    private int size = 480;
    private int lastSize = 480;
    private bool rendering;
    private int progress;
    private long lastMilliseconds;
    private int refinedPixels;
    private double lightAzimuth = 55, lightElevation = 50, lightIntensity = 1, ambient = 1;
    private Glass? glass;
    private CancellationTokenSource? cancel;
    private bool rendered;

    private string selectedKey
    {
        get => selectedKeyValue;
        set
        {
            selectedKeyValue = value;
            int slash = value.IndexOf('/');
            glass = GlassCatalog.Find(value[..slash], value[(slash + 1)..]);
        }
    }

    protected override void OnInitialized() => selectedKey = selectedKeyValue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !rendered)
        {
            rendered = true;
            await Start();
        }
    }

    private RenderShape Shape => shapeKey switch
    {
        "cube" => RenderShape.Cube(),
        "prism" => RenderShape.Prism(sides),
        "octahedron" => RenderShape.Octahedron(),
        "dodecahedron" => RenderShape.Dodecahedron(),
        "icosahedron" => RenderShape.Icosahedron(),
        _ => RenderShape.Sphere(),
    };

    private Backdrop Scenery => backdropKey switch
    {
        "stripes" => Backdrop.Stripes,
        "grid" => Backdrop.Grid,
        "paper" => Backdrop.Paper,
        "night" => Backdrop.Night,
        _ => Backdrop.Checker,
    };

    private async Task Start()
    {
        if (glass is null || rendering)
        {
            return;
        }

        cancel?.Cancel();
        cancel = new CancellationTokenSource();
        CancellationToken token = cancel.Token;
        rendering = true;
        progress = 0;
        lastSize = size;
        StateHasChanged();
        await Task.Yield();

        GlassRenderer renderer = new(glass, Shape, sizeMm / 2d, Scenery, lightAzimuth, lightElevation, lightIntensity, ambient);
        System.Diagnostics.Stopwatch watch = new();

        // Pass 1: a quarter-size preview, drawn scaled, so the solid appears at once.
        int previewSize = Math.Max(80, size / 4);
        Vector3[] previewLinear = new Vector3[previewSize * previewSize];
        byte[] previewRgba = new byte[previewSize * previewSize * 4];
        watch.Start();
        renderer.RenderRows(previewLinear, previewRgba, previewSize, 0, previewSize);
        watch.Stop();
        await Js.InvokeVoidAsync("caustikonCanvas.put", "render-canvas", previewSize, previewSize, previewRgba, size, size);
        await Task.Yield();

        // Pass 2: every pixel at full size, in bands.
        Vector3[] linear = new Vector3[size * size];
        byte[] rgba = new byte[size * size * 4];
        const int band = 24;
        for (int row = 0; row < size && !token.IsCancellationRequested; row += band)
        {
            int end = Math.Min(size, row + band);
            watch.Start();
            renderer.RenderRows(linear, rgba, size, row, end);
            watch.Stop();
            progress = end * 90 / size;
            StateHasChanged();
            await Task.Yield();
        }

        if (!token.IsCancellationRequested)
        {
            await Js.InvokeVoidAsync("caustikonCanvas.put", "render-canvas", size, size, rgba, size, size);
        }

        // Pass 3: four samples per pixel where neighbours disagree; the rest already converged with one.
        int refined = 0;
        for (int row = 0; row < size && !token.IsCancellationRequested; row += band * 2)
        {
            int end = Math.Min(size, row + band * 2);
            watch.Start();
            refined += renderer.RefineEdges(linear, rgba, size, row, end);
            watch.Stop();
            progress = 90 + end * 10 / size;
            StateHasChanged();
            await Task.Yield();
        }

        if (!token.IsCancellationRequested)
        {
            await Js.InvokeVoidAsync("caustikonCanvas.put", "render-canvas", size, size, rgba, size, size);
            lastMilliseconds = watch.ElapsedMilliseconds;
            refinedPixels = refined;
        }

        rendering = false;
        StateHasChanged();
    }

    private static string IndexAt(Glass g, double wavelength) =>
        g.IndexAt(Math.Clamp(wavelength, g.Model.MinimumWavelengthNanometers, g.Model.MaximumWavelengthNanometers), out double n) == DispersionStatus.Success ? SiteInfo.Number(n, 4) : "—";

    private string Tau(Glass g, double wavelength)
    {
        if (g.Extinction is not { } extinction)
        {
            return "no k data";
        }

        extinction.InternalTransmittance(Math.Clamp(wavelength, extinction.MinimumWavelengthNanometers, extinction.MaximumWavelengthNanometers), sizeMm, out double t);
        return SiteInfo.Number(t, 3);
    }

    public void Dispose() => cancel?.Cancel();
}
